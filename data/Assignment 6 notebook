        "        method_label = 'Option 2: RobustScaler Normalization'\n",
        "        df_sim = add_engineered_features(df_sim, do_col='DO_sim')\n",
        "        model_robust = train_pipeline(df_clean_features, features_full, reg_type='SVR', scaler_type='Robust')\n",
