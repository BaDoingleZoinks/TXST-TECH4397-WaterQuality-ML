      "metadata": {},
      "outputs": [],
      "source": [
        "# ==========================================================================\n",
        "# CHOOSE YOUR RESCUE OPTION HERE (Change the number to 1, 2, 3, or 4)\n",
        "# ==========================================================================\n",
