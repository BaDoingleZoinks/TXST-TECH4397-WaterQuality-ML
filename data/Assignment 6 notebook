        "    \n",
        "    # Test Full Model (Model A)\n",
        "    acc_f, f1_f, r2_f, rmse_f = evaluate_pipeline(model_A_full, df_sim, do_col_override='DO_sim')\n",
        "    part3_rows.append({\n",
        "        'Drift Condition': cond_name,\n",
        "        'Model': 'Full Model (7-Feature)',\n",
        "        'Accuracy': acc_f, 'Macro_F1': f1_f, 'R2': r2_f, 'RMSE': rmse_f\n",
        "    })\n",
        "    \n",
        "    # Test DO-Free Model (Model B)\n",
        "    acc_d, f1_d, r2_d, rmse_d = evaluate_pipeline(model_B_dofree, df_sim, do_col_override='DO_sim')\n",
        "    part3_rows.append({\n",
        "        'Drift Condition': cond_name,\n",
        "        'Model': 'DO-Free Model (5-Feature)',\n",
        "        'Accuracy': acc_d, 'Macro_F1': f1_d, 'R2': r2_d, 'RMSE': rmse_d\n",
        "    })\n",
        "\n",
        "part3_table = pd.DataFrame(part3_rows)\n",
        "print('=== PART 3: MODEL STRESS TEST TABLE ===')\n",
        "print(part3_table.to_string(index=False))"
      ]
    },
