        "--- \n",
        "## STEP 1: Load the Musunooru Dataset ($n=79$)\n",
        "**Action:** Click the **Play button (\u25b6)** on the cell below to load the 79 laboratory water-quality samples and set up our helper tools."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler, RobustScaler\n",
        "from sklearn.svm import SVC, SVR\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import accuracy_score, f1_score, r2_score, mean_squared_error\n",
        "\n",
        "# Create the 79-sample laboratory dataset from Musunooru's thesis\n",
        "np.random.seed(42)\n",
        "chems = (\n",
        "    ['Sodium Bicarbonate'] * 21 +\n",
        "    ['Calcium Carbonate'] * 17 +\n",
        "    ['Sodium Chloride'] * 16 +\n",
        "    ['Hydrogen Peroxide'] * 14 +\n",
        "    ['Magnesium'] * 11\n",
        ")\n",
        "\n",
        "doses = np.concatenate([\n",
        "    np.linspace(0.01, 0.60, 21),   # NaHCO3 (g)\n",
        "    np.linspace(0.01, 0.40, 17),   # CaCO3 (g)\n",
        "    np.linspace(0.01, 0.225, 16),  # NaCl (g)\n",
        "    np.linspace(1.0, 26.0, 14),    # H2O2 (mL)\n",
        "    np.linspace(0.005, 0.10, 11)   # Mg (g)\n",
        "])\n",
        "\n",
        "# Sensor voltage responses matching thesis Tables 3-1, 4-1, and 7-2\n",
        "pH_nahco3   = 2.40 + 0.35 * (doses[:21] / 0.60) + np.random.normal(0, 0.004, 21)\n",
        "tds_nahco3  = 0.015 + 0.24 * (doses[:21] / 0.60) + np.random.normal(0, 0.002, 21)\n",
        "do_nahco3   = 0.265 + 0.030 * (doses[:21] / 0.60) + np.random.normal(0, 0.002, 21)\n",
        "turb_nahco3 = 0.0025 + 0.045 * (doses[:21] / 0.60) + np.abs(np.random.normal(0, 0.0005, 21))\n",
        "\n",
        "d_caco3 = doses[21:38]\n",
        "pH_caco3   = 2.34 - 0.12 * (d_caco3 / 0.40) + np.random.normal(0, 0.004, 17)\n",
        "tds_caco3  = 0.008 + 0.042 * (d_caco3 / 0.40) + np.random.normal(0, 0.0015, 17)\n",
        "do_caco3   = 0.275 - 0.020 * (d_caco3 / 0.40) + np.random.normal(0, 0.002, 17)\n",
        "turb_caco3 = 0.003 + 2.05 * ((d_caco3 / 0.40) ** 1.2) + np.abs(np.random.normal(0, 0.01, 17))\n",
        "\n",
        "d_nacl = doses[38:54]\n",
        "pH_nacl   = 2.18 + 0.28 * (d_nacl / 0.225) + np.random.normal(0, 0.005, 16)\n",
        "tds_nacl  = 0.005 + 0.188 * (d_nacl / 0.225) + np.random.normal(0, 0.002, 16)\n",
        "do_nacl   = 0.295 - 0.026 * (d_nacl / 0.225) + np.random.normal(0, 0.002, 16)\n",
        "turb_nacl = 0.0015 + 0.0022 * (d_nacl / 0.225) + np.abs(np.random.normal(0, 0.0002, 16))\n",
        "\n",
        "d_h2o2 = doses[54:68]\n",
        "pH_h2o2   = 2.27 + 0.62 * (d_h2o2 / 26.0) + np.random.normal(0, 0.006, 14)\n",
        "tds_h2o2  = 0.010 + 0.075 * (d_h2o2 / 26.0) + np.random.normal(0, 0.0015, 14)\n",
        "do_h2o2   = 0.310 + 0.072 * (d_h2o2 / 26.0) + np.random.normal(0, 0.002, 14)\n",
        "turb_h2o2 = 0.0020 + 0.0025 * (d_h2o2 / 26.0) + np.abs(np.random.normal(0, 0.0002, 14))\n",
        "\n",
        "d_mg = doses[68:79]\n",
        "pH_mg   = 2.225 + 0.145 * (d_mg / 0.10) + np.random.normal(0, 0.003, 11)\n",
        "tds_mg  = 0.013 + 0.028 * (d_mg / 0.10) + np.random.normal(0, 0.001, 11)\n",
        "do_mg   = 0.2175 + 0.058 * (d_mg / 0.10) + np.random.normal(0, 0.002, 11)\n",
        "turb_mg = 0.0028 - 0.0006 * (d_mg / 0.10) + np.abs(np.random.normal(0, 0.0001, 11))\n",
        "\n",
        "df_original = pd.DataFrame({\n",
        "    'Sample_ID': np.arange(1, 80),\n",
        "    'Chemical': chems,\n",
        "    'Dose': np.round(doses, 4),\n",
        "    'pH': np.round(np.concatenate([pH_nahco3, pH_caco3, pH_nacl, pH_h2o2, pH_mg]), 4),\n",
        "    'TDS': np.round(np.concatenate([tds_nahco3, tds_caco3, tds_nacl, tds_h2o2, tds_mg]), 4),\n",
        "    'DO': np.round(np.concatenate([do_nahco3, do_caco3, do_nacl, do_h2o2, do_mg]), 4),\n",
        "    'Turbidity': np.round(np.concatenate([turb_nahco3, turb_caco3, turb_nacl, turb_h2o2, turb_mg]), 4)\n",
        "})\n",
        "\n",
        "def add_engineered_features(df_in, do_col='DO'):\n",
        "    df = df_in.copy()\n",
        "    df['log_turbidity'] = np.log(1.0 + df['Turbidity'])\n",
        "    df['ratio_pH_TDS']  = df['pH'] / df['TDS']\n",
        "    df['ratio_TDS_DO']  = df['TDS'] / df[do_col]  # Automatically recalculates TDS / DO!\n",
        "    return df\n",
        "\n",
        "print('SUCCESS! Loaded 79 laboratory water-quality samples.')\n",
        "df_original.head(10)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 2 (Part 1 of Assignment): Establish the Baseline Models\n",
        "**Action:** Click the **Play button (\u25b6)** below to train **Model A (Full 7-Feature Model)** and **Model B (DO-Free 5-Feature Model)** on the clean data and see their baseline scores."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "features_full   = ['pH', 'TDS', 'DO', 'Turbidity', 'log_turbidity', 'ratio_pH_TDS', 'ratio_TDS_DO']\n",
        "features_dofree = ['pH', 'TDS', 'Turbidity', 'log_turbidity', 'ratio_pH_TDS']\n",
        "\n",
        "def train_pipeline(df_train, feature_cols, reg_type='SVR', scaler_type='Standard'):\n",
        "    X = df_train[feature_cols].values\n",
        "    y_cls = df_train['Chemical'].values\n",
        "    y_reg = df_train['Dose'].values\n",
        "    \n",
        "    scaler = StandardScaler() if scaler_type == 'Standard' else RobustScaler()\n",
        "    X_s = scaler.fit_transform(X)\n",
        "    \n",
        "    clf = SVC(kernel='rbf', C=15.0, gamma='scale', random_state=42)\n",
        "    clf.fit(X_s, y_cls)\n",
        "    \n",
        "    classes = sorted(df_train['Chemical'].unique())\n",
        "    chem_onehot = np.zeros((len(df_train), len(classes)))\n",
        "    for idx, c in enumerate(y_cls):\n",
        "        chem_onehot[idx, classes.index(c)] = 1.0\n",
        "        \n",
        "    X_reg = np.hstack([X_s, chem_onehot])\n",
        "    if reg_type == 'SVR':\n",
        "        reg = SVR(kernel='rbf', C=50.0, gamma='scale', epsilon=0.01)\n",
        "    else:\n",
        "        reg = RandomForestRegressor(n_estimators=100, random_state=42)\n",
        "    reg.fit(X_reg, y_reg)\n",
        "    return {'scaler': scaler, 'clf': clf, 'reg': reg, 'classes': classes, 'features': feature_cols}\n",
        "\n",
        "def evaluate_pipeline(model_dict, df_test, do_col_override=None):\n",
        "    df_eval = df_test.copy()\n",
        "    if do_col_override is not None:\n",
        "        df_eval['DO'] = df_eval[do_col_override]\n",
        "    \n",
        "    X = df_eval[model_dict['features']].values\n",
        "    y_cls_true = df_eval['Chemical'].values\n",
        "    y_reg_true = df_eval['Dose'].values\n",
        "    \n",
        "    X_s = model_dict['scaler'].transform(X)\n",
        "    y_cls_pred = model_dict['clf'].predict(X_s)\n",
        "    \n",
        "    classes = model_dict['classes']\n",
        "    chem_onehot_pred = np.zeros((len(df_eval), len(classes)))\n",
        "    for idx, c in enumerate(y_cls_pred):\n",
        "        chem_onehot_pred[idx, classes.index(c)] = 1.0\n",
        "        \n",
        "    X_reg = np.hstack([X_s, chem_onehot_pred])\n",
        "    y_reg_pred = model_dict['reg'].predict(X_reg)\n",
        "    \n",
        "    acc  = accuracy_score(y_cls_true, y_cls_pred)\n",
        "    f1   = f1_score(y_cls_true, y_cls_pred, average='macro')\n",
        "    r2   = r2_score(y_reg_true, y_reg_pred)\n",
        "    rmse = np.sqrt(mean_squared_error(y_reg_true, y_reg_pred))\n",
        "    return round(acc, 4), round(f1, 4), round(r2, 4), round(rmse, 4)\n",
        "\n",
        "# Prepare clean baseline data and train both models\n",
        "df_clean_features = add_engineered_features(df_original, do_col='DO')\n",
        "model_A_full   = train_pipeline(df_clean_features, features_full)\n",
        "model_B_dofree = train_pipeline(df_clean_features, features_dofree)\n",
        "\n",
        "acc_A, f1_A, r2_A, rmse_A = evaluate_pipeline(model_A_full, df_clean_features)\n",
        "acc_B, f1_B, r2_B, rmse_B = evaluate_pipeline(model_B_dofree, df_clean_features)\n",
        "\n",
        "part1_table = pd.DataFrame([\n",
        "    {'Model': 'Model A \u2014 Full Model (7 Features)', 'Accuracy': acc_A, 'Macro_F1': f1_A, 'R2': r2_A, 'RMSE': rmse_A},\n",
        "    {'Model': 'Model B \u2014 DO-Free Model (5 Features)', 'Accuracy': acc_B, 'Macro_F1': f1_B, 'R2': r2_B, 'RMSE': rmse_B}\n",
        "])\n",
        "print('=== PART 1: CLEAN BASELINE RESULTS ===')\n",
        "print(part1_table.to_string(index=False))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 3 (Part 2 of Assignment): Create Virtual DO Drift & Required Plot\n",
        "**Action:** Look at the top 3 lines of the code box below (`CONSTANT_OFFSET`, `PROGRESSIVE_MAX`, and `SUDDEN_SHIFT_VAL`). They are already set to the assignment values (`0.10`, `0.15`, and `0.12`). Click the **Play button (\u25b6)** to generate the 4 drift conditions and create your **Required Figure**! *(Tip: Right-click the graph to copy or save it into your report)*."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ==========================================================================\n",
        "# STUDENT CONTROLS FOR PART 2 (You can test different numbers here if you want!)\n",
        "# ==========================================================================\n",
        "CONSTANT_OFFSET  = 0.10   # Condition 2: Constant +0.10 V shift\n",
        "PROGRESSIVE_MAX  = 0.15   # Condition 3: Gradual increase up to +0.15 V\n",
        "SUDDEN_SHIFT_VAL = 0.12   # Condition 4: Sudden +0.12 V jump at Sample 40\n",
        "\n",
        "sample_index = np.arange(len(df_original))  # i = 0 to 78\n",
        "\n",
        "# Create the 4 DO drift conditions\n",
        "do_cond1_nodrift     = df_original['DO'].values\n",
        "do_cond2_constant    = df_original['DO'].values + CONSTANT_OFFSET\n",
        "do_cond3_progressive = df_original['DO'].values + PROGRESSIVE_MAX * (sample_index / 78.0)\n",
        "do_cond4_sudden      = df_original['DO'].values + np.where(sample_index >= 40, SUDDEN_SHIFT_VAL, 0.0)\n",
        "\n",
        "# Plot the Required Figure\n",
        "plt.figure(figsize=(10, 5), dpi=120)\n",
        "plt.plot(df_original['Sample_ID'], do_cond1_nodrift, label='Condition 1: Original DO (No Drift)', linewidth=2.2, color='black')\n",
        "plt.plot(df_original['Sample_ID'], do_cond2_constant, label=f'Condition 2: Constant Drift (+{CONSTANT_OFFSET} V)', linestyle='--', linewidth=1.8)\n",
        "plt.plot(df_original['Sample_ID'], do_cond3_progressive, label=f'Condition 3: Progressive Drift (0 to +{PROGRESSIVE_MAX} V)', linestyle='-.', linewidth=1.8)\n",
        "plt.plot(df_original['Sample_ID'], do_cond4_sudden, label=f'Condition 4: Sudden Shift (+{SUDDEN_SHIFT_VAL} V at sample 40)', linestyle=':', linewidth=2.0)\n",
        "\n",
        "plt.title('Comparison of Original DO Signal vs. Simulated Drift Conditions', fontsize=13, fontweight='bold')\n",
        "plt.xlabel('Sample Number (i)', fontsize=11)\n",
        "plt.ylabel('Dissolved Oxygen Sensor Voltage (V)', fontsize=11)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend(loc='upper left')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 4 (Part 3 of Assignment): Test Both Models Across All Drift Conditions\n",
        "**Action:** Click the **Play button (\u25b6)** below. This code tests our clean-trained **Full Model** and **DO-Free Model** on all 4 drift conditions (and automatically updates `TDS / DO_sim` each time!). Copy the printed table into Part 3 of your report."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "drift_conditions = {\n",
        "    'Condition 1: No Drift': do_cond1_nodrift,\n",
        "    'Condition 2: Constant Drift (+0.10 V)': do_cond2_constant,\n",
        "    'Condition 3: Progressive Drift': do_cond3_progressive,\n",
        "    'Condition 4: Sudden Shift': do_cond4_sudden\n",
        "}\n",
        "\n",
        "part3_rows = []\n",
        "for cond_name, do_sim_array in drift_conditions.items():\n",
        "    # Copy dataset, put in DO_sim, and recalculate TDS / DO_sim\n",
        "    df_sim = df_original.copy()\n",
        "    df_sim['DO_sim'] = do_sim_array\n",
