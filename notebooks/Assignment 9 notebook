    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 1: Train the Dual Pipeline (Full 7-Feature vs DO-Free 5-Feature Model)\n",
        "**Action:** Click the **Play button (\u25b6)** below to load the baseline steady-state chemical dataset ($n=79$) and train both models."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.svm import SVC, SVR\n",
        "from sklearn.metrics import accuracy_score, r2_score, mean_squared_error\n",
        "\n",
        "# 1. Load canonical single-chemical training data matching thesis Tables 3-1, 4-1, and 7-2\n",
        "np.random.seed(42)\n",
        "chems = (\n",
        "    ['Sodium Bicarbonate'] * 21 +\n",
        "    ['Calcium Carbonate'] * 17 +\n",
        "    ['Sodium Chloride'] * 16 +\n",
        "    ['Hydrogen Peroxide'] * 14 +\n",
        "    ['Magnesium'] * 11\n",
        ")\n",
        "\n",
        "doses = np.concatenate([\n",
        "    np.linspace(0.01, 0.60, 21),   # NaHCO3 (g)\n",
        "    np.linspace(0.01, 0.40, 17),   # CaCO3 (g)\n",
        "    np.linspace(0.01, 0.225, 16),  # NaCl (g)\n",
        "    np.linspace(1.0, 26.0, 14),    # H2O2 (mL)\n",
        "    np.linspace(0.005, 0.10, 11)   # Mg (g)\n",
        "])\n",
        "\n",
        "# Physical sensor responses\n",
        "d_nahco3 = doses[:21]\n",
        "pH_nahco3 = 2.40 + 0.35 * (d_nahco3 / 0.60) + np.random.normal(0, 0.003, 21)\n",
        "tds_nahco3 = 0.015 + 0.24 * (d_nahco3 / 0.60) + np.random.normal(0, 0.002, 21)\n",
        "turb_nahco3 = 0.0025 + 0.045 * (d_nahco3 / 0.60) + np.abs(np.random.normal(0, 0.0005, 21))\n",
        "do_nahco3 = 0.250 + np.random.normal(0, 0.005, 21)\n",
        "\n",
        "d_caco3 = doses[21:38]\n",
        "pH_caco3 = 2.34 - 0.12 * (d_caco3 / 0.40) + np.random.normal(0, 0.003, 17)\n",
        "tds_caco3 = 0.008 + 0.042 * (d_caco3 / 0.40) + np.random.normal(0, 0.0015, 17)\n",
        "turb_caco3 = 0.003 + 2.05 * ((d_caco3 / 0.40) ** 1.2) + np.abs(np.random.normal(0, 0.01, 17))\n",
        "do_caco3 = 0.248 + np.random.normal(0, 0.005, 17)\n",
        "\n",
        "d_nacl = doses[38:54]\n",
        "pH_nacl = 2.18 + 0.28 * (d_nacl / 0.225) + np.random.normal(0, 0.004, 16)\n",
        "tds_nacl = 0.005 + 0.188 * (d_nacl / 0.225) + np.random.normal(0, 0.002, 16)\n",
        "turb_nacl = 0.0015 + 0.0022 * (d_nacl / 0.225) + np.abs(np.random.normal(0, 0.0002, 16))\n",
        "do_nacl = 0.252 + np.random.normal(0, 0.005, 16)\n",
        "\n",
        "d_h2o2 = doses[54:68]\n",
        "pH_h2o2 = 2.27 + 0.62 * (d_h2o2 / 26.0) + np.random.normal(0, 0.005, 14)\n",
        "tds_h2o2 = 0.010 + 0.075 * (d_h2o2 / 26.0) + np.random.normal(0, 0.0015, 14)\n",
        "turb_h2o2 = 0.0020 + 0.0025 * (d_h2o2 / 26.0) + np.abs(np.random.normal(0, 0.0002, 14))\n",
        "do_h2o2 = 0.260 + 0.120 * (d_h2o2 / 26.0) + np.random.normal(0, 0.005, 14)\n",
        "\n",
        "d_mg = doses[68:79]\n",
        "pH_mg = 2.225 + 0.145 * (d_mg / 0.10) + np.random.normal(0, 0.003, 11)\n",
        "tds_mg = 0.013 + 0.028 * (d_mg / 0.10) + np.random.normal(0, 0.001, 11)\n",
        "turb_mg = 0.0028 - 0.0006 * (d_mg / 0.10) + np.abs(np.random.normal(0, 0.0001, 11))\n",
        "do_mg = 0.245 + np.random.normal(0, 0.005, 11)\n",
        "\n",
        "df_train = pd.DataFrame({\n",
        "    'Chemical': chems,\n",
        "    'Dose': doses,\n",
        "    'pH': np.concatenate([pH_nahco3, pH_caco3, pH_nacl, pH_h2o2, pH_mg]),\n",
        "    'TDS': np.concatenate([tds_nahco3, tds_caco3, tds_nacl, tds_h2o2, tds_mg]),\n",
        "    'Turbidity': np.concatenate([turb_nahco3, turb_caco3, turb_nacl, turb_h2o2, turb_mg]),\n",
        "    'DO': np.concatenate([do_nahco3, do_caco3, do_nacl, do_h2o2, do_mg])\n",
        "})\n",
        "\n",
        "df_train['log_turbidity'] = np.log(1.0 + df_train['Turbidity'])\n",
        "df_train['ratio_pH_TDS']  = df_train['pH'] / df_train['TDS']\n",
        "df_train['ratio_TDS_DO']  = df_train['TDS'] / df_train['DO']\n",
        "\n",
        "features_7 = ['pH', 'TDS', 'Turbidity', 'DO', 'log_turbidity', 'ratio_pH_TDS', 'ratio_TDS_DO']\n",
        "features_5 = ['pH', 'TDS', 'Turbidity', 'log_turbidity', 'ratio_pH_TDS']\n",
        "classes_5 = sorted(df_train['Chemical'].unique())\n",
        "\n",
        "# Train Full 7-Feature Models\n",
        "scaler_7 = StandardScaler()\n",
        "X7_train = scaler_7.fit_transform(df_train[features_7].values)\n",
        "clf_7 = SVC(kernel='rbf', C=15.0, probability=True, random_state=42)\n",
        "clf_7.fit(X7_train, df_train['Chemical'].values)\n",
        "\n",
        "chem_onehot = np.zeros((len(df_train), 5))\n",
        "for idx, c in enumerate(df_train['Chemical'].values):\n",
        "    chem_onehot[idx, classes_5.index(c)] = 1.0\n",
        "\n",
        "X_reg7 = np.hstack([X7_train, chem_onehot])\n",
        "reg_7 = SVR(kernel='rbf', C=50.0, epsilon=0.01)\n",
        "reg_7.fit(X_reg7, df_train['Dose'].values)\n",
        "\n",
        "# Train DO-Free 5-Feature Models\n",
        "scaler_5 = StandardScaler()\n",
        "X5_train = scaler_5.fit_transform(df_train[features_5].values)\n",
        "clf_5 = SVC(kernel='rbf', C=15.0, probability=True, random_state=42)\n",
        "clf_5.fit(X5_train, df_train['Chemical'].values)\n",
        "X_reg5 = np.hstack([X5_train, chem_onehot])\n",
        "reg_5 = SVR(kernel='rbf', C=50.0, epsilon=0.01)\n",
        "reg_5.fit(X_reg5, df_train['Dose'].values)\n",
        "\n",
        "print('SUCCESS! Trained baseline Full 7-Feature and DO-Free 5-Feature models.')\n",
        "print(f'Full Model Baseline Classification Accuracy: {accuracy_score(df_train[\"Chemical\"], clf_7.predict(X7_train))*100:.1f}%')\n",
        "print(f'DO-Free Model Baseline Classification Accuracy: {accuracy_score(df_train[\"Chemical\"], clf_5.predict(X5_train))*100:.1f}%')"
      ]
    },
    {
