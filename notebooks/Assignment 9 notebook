      "source": [
        "--- \n",
        "## STEP 2 (Part 2): Evaluate Residual Errors Across 3 Operational Regimes\n",
        "**Action:** Click the **Play button (\u25b6)** below. This evaluates the dose prediction residuals across (1) Clean Baseline, (2) Uncorrected DO Drift (+0.12 V), and (3) Chemically Buffered River Water."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Generate test dataset (held-out simulation)\n",
        "np.random.seed(105)\n",
        "test_df = df_train.sample(25, random_state=105).copy()\n",
        "\n",
        "# Regime 1: Clean Baseline (No drift)\n",
        "X7_test1 = scaler_7.transform(test_df[features_7].values)\n",
        "preds1_cls = clf_7.predict(X7_test1)\n",
        "oh1 = np.zeros((len(test_df), 5))\n",
        "for idx, c in enumerate(preds1_cls):\n",
        "    oh1[idx, classes_5.index(c)] = 1.0\n",
        "preds1_dose = reg_7.predict(np.hstack([X7_test1, oh1]))\n",
        "res1 = preds1_dose - test_df['Dose'].values\n",
        "\n",
        "# Regime 2: Uncorrected Hardware Aeration Drift (+0.12V on DO sensor)\n",
        "df_regime2 = test_df.copy()\n",
        "df_regime2['DO'] = df_regime2['DO'] + 0.12\n",
        "df_regime2['ratio_TDS_DO'] = df_regime2['TDS'] / df_regime2['DO']\n",
        "X7_test2 = scaler_7.transform(df_regime2[features_7].values)\n",
        "preds2_cls = clf_7.predict(X7_test2)\n",
        "oh2 = np.zeros((len(test_df), 5))\n",
        "for idx, c in enumerate(preds2_cls):\n",
        "    oh2[idx, classes_5.index(c)] = 1.0\n",
        "preds2_dose = reg_7.predict(np.hstack([X7_test2, oh2]))\n",
        "res2 = preds2_dose - test_df['Dose'].values\n",
        "\n",
        "# Regime 3: Chemically Buffered Karst River Water (Alkalinity shifts pH +5.2, flattens response)\n",
        "df_regime3 = test_df.copy()\n",
        "df_regime3['pH'] = df_regime3['pH'] + 5.20\n",
        "df_regime3['TDS'] = df_regime3['TDS'] + 0.45\n",
        "df_regime3['ratio_pH_TDS'] = df_regime3['pH'] / df_regime3['TDS']\n",
        "df_regime3['ratio_TDS_DO'] = df_regime3['TDS'] / df_regime3['DO']\n",
        "X7_test3 = scaler_7.transform(df_regime3[features_7].values)\n",
        "preds3_cls = clf_7.predict(X7_test3)\n",
        "oh3 = np.zeros((len(test_df), 5))\n",
        "for idx, c in enumerate(preds3_cls):\n",
        "    oh3[idx, classes_5.index(c)] = 1.0\n",
        "preds3_dose = reg_7.predict(np.hstack([X7_test3, oh3]))\n",
        "res3 = preds3_dose - test_df['Dose'].values\n",
        "\n",
        "table_res = [\n",
        "    {'Operational Regime': 'Regime 1: Clean Baseline (Pure DI)', 'Mean Error (Bias)': round(np.mean(res1), 4), 'Error Std Dev': round(np.std(res1), 4), 'Max Absolute Error': round(np.max(np.abs(res1)), 4), 'Regression R2': round(r2_score(test_df['Dose'], preds1_dose), 4)},\n",
        "    {'Operational Regime': 'Regime 2: Hardware DO Aeration Drift (+0.12V)', 'Mean Error (Bias)': round(np.mean(res2), 4), 'Error Std Dev': round(np.std(res2), 4), 'Max Absolute Error': round(np.max(np.abs(res2)), 4), 'Regression R2': round(r2_score(test_df['Dose'], preds2_dose), 4)},\n",
        "    {'Operational Regime': 'Regime 3: Chemically Buffered Karst River Water', 'Mean Error (Bias)': round(np.mean(res3), 4), 'Error Std Dev': round(np.std(res3), 4), 'Max Absolute Error': round(np.max(np.abs(res3)), 4), 'Regression R2': round(r2_score(test_df['Dose'], preds3_dose), 4)}\n",
        "]\n",
        "\n",
        "print('=== PART 2: RESIDUAL ERROR STATISTICS ACROSS OPERATIONAL REGIMES ===')\n",
        "print(pd.DataFrame(table_res).to_string(index=False))\n",
        "\n",
        "# Generate Comparative Boxplot\n",
        "plt.figure(figsize=(9, 5), dpi=120)\n",
        "plt.boxplot([res1, res2, res3], labels=['Regime 1\\nClean DI', 'Regime 2\\nDO Drift (+0.12V)', 'Regime 3\\nKarst River Water'], patch_artist=True, boxprops=dict(facecolor='lightblue', color='blue'))\n",
        "plt.axhline(0, color='red', linestyle='--', linewidth=1.2, label='Zero Error Baseline')\n",
        "plt.ylabel('Prediction Residual Error (Predicted - True Dose)', fontsize=10)\n",
        "plt.title('Residual Error Distributions Under Sensor Drift and Matrix Shift', fontsize=12, fontweight='bold')\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
