        "--- \n",
        "## STEP 4 (Part 5): Streeter-Phelps Dissolved Oxygen Sag Curve Simulation\n",
        "**Action:** Click the **Play button (\u25b6)** below to plot the official NCEES FE Reference Handbook Streeter-Phelps Dissolved Oxygen Sag Curve."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Streeter-Phelps Dissolved Oxygen Sag Modeling (NCEES FE Reference Handbook Parameters)\n",
        "# Parameters from Part 5:\n",
        "DO_sat = 9.09   # mg/L at 20 deg C\n",
        "DO_0   = 6.50   # mg/L\n",
        "D_0    = DO_sat - DO_0  # Initial deficit = 2.59 mg/L\n",
        "L_0    = 18.0   # mg/L ultimate BOD\n",
        "k_d    = 0.25   # day^-1\n",
        "k_r    = 0.45   # day^-1\n",
        "u      = 18.0   # miles/day\n",
        "\n",
        "t = np.linspace(0, 10, 200) # days\n",
        "x = u * t                   # river miles downstream\n",
        "\n",
        "# Streeter-Phelps Equation from FE Reference Handbook:\n",
        "# D(t) = [k_d * L_0 / (k_r - k_d)] * [exp(-k_d * t) - exp(-k_r * t)] + D_0 * exp(-k_r * t)\n",
        "D_t = (k_d * L_0 / (k_r - k_d)) * (np.exp(-k_d * t) - np.exp(-k_r * t)) + D_0 * np.exp(-k_r * t)\n",
        "DO_t = DO_sat - D_t\n",
        "\n",
        "# Critical values:\n",
        "t_c = (1.0 / (k_r - k_d)) * np.log((k_r / k_d) * (1.0 - D_0 * (k_r - k_d) / (k_d * L_0)))\n",
        "x_c = u * t_c\n",
        "D_c = (k_d / k_r) * L_0 * np.exp(-k_d * t_c)\n",
        "DO_min = DO_sat - D_c\n",
        "\n",
        "plt.figure(figsize=(10, 5.5), dpi=120)\n",
        "plt.plot(x, DO_t, color='blue', linewidth=2.2, label='Dissolved Oxygen Profile (DO)')\n",
        "plt.axhline(4.0, color='red', linestyle='--', linewidth=1.5, label='Texas Regulatory Standard (4.0 mg/L)')\n",
        "plt.axhline(DO_sat, color='green', linestyle=':', label=f'Saturation DO ({DO_sat} mg/L)')\n",
        "plt.plot(x_c, DO_min, marker='o', markersize=8, color='darkred', label=f'Critical Sag Minimum ({DO_min:.2f} mg/L at {x_c:.1f} mi)')\n",
        "\n",
        "plt.xlabel('Distance Downstream (River Miles)', fontsize=10)\n",
        "plt.ylabel('Dissolved Oxygen Concentration (mg/L)', fontsize=10)\n",
        "plt.title('NCEES FE Reference Handbook: Streeter-Phelps Oxygen Sag Curve', fontsize=12, fontweight='bold')\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.legend(loc='lower right')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f'Critical Travel Time (t_c): {t_c:.3f} days')\n",
        "print(f'Critical Downstream Distance (x_c): {x_c:.2f} miles')\n",
        "print(f'Critical Oxygen Deficit (D_c): {D_c:.2f} mg/L')\n",
        "print(f'Minimum River DO (DO_min): {DO_min:.2f} mg/L')"
      ]
    }
