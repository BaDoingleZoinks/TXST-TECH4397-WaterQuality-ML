    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 1: Load Canonical Single-Chemical Baseline Data ($n=79$)\n",
        "**Action:** Click the **Play button (\u25b6)** below to load Shashank Musunooru's steady-state chemical dosing data and train the baseline Single-Label SVM model."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.multiclass import OneVsRestClassifier\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import accuracy_score, hamming_loss, mean_squared_error, r2_score\n",
        "\n",
        "# 1. Load canonical single-chemical training data matching thesis Tables 3-1, 4-1, and 7-2\n",
        "np.random.seed(42)\n",
        "chems = (\n",
        "    ['Sodium Bicarbonate'] * 21 +\n",
        "    ['Calcium Carbonate'] * 17 +\n",
        "    ['Sodium Chloride'] * 16 +\n",
        "    ['Hydrogen Peroxide'] * 14 +\n",
        "    ['Magnesium'] * 11\n",
        ")\n",
        "\n",
        "doses = np.concatenate([\n",
        "    np.linspace(0.01, 0.60, 21),   # NaHCO3 (g)\n",
        "    np.linspace(0.01, 0.40, 17),   # CaCO3 (g)\n",
        "    np.linspace(0.01, 0.225, 16),  # NaCl (g)\n",
        "    np.linspace(1.0, 26.0, 14),    # H2O2 (mL)\n",
        "    np.linspace(0.005, 0.10, 11)   # Mg (g)\n",
        "])\n",
        "\n",
        "# Physical sensor responses\n",
        "d_nahco3 = doses[:21]\n",
        "pH_nahco3 = 2.40 + 0.35 * (d_nahco3 / 0.60) + np.random.normal(0, 0.003, 21)\n",
        "tds_nahco3 = 0.015 + 0.24 * (d_nahco3 / 0.60) + np.random.normal(0, 0.002, 21)\n",
        "turb_nahco3 = 0.0025 + 0.045 * (d_nahco3 / 0.60) + np.abs(np.random.normal(0, 0.0005, 21))\n",
        "\n",
        "d_caco3 = doses[21:38]\n",
        "pH_caco3 = 2.34 - 0.12 * (d_caco3 / 0.40) + np.random.normal(0, 0.003, 17)\n",
        "tds_caco3 = 0.008 + 0.042 * (d_caco3 / 0.40) + np.random.normal(0, 0.0015, 17)\n",
        "turb_caco3 = 0.003 + 2.05 * ((d_caco3 / 0.40) ** 1.2) + np.abs(np.random.normal(0, 0.01, 17))\n",
        "\n",
        "d_nacl = doses[38:54]\n",
        "pH_nacl = 2.18 + 0.28 * (d_nacl / 0.225) + np.random.normal(0, 0.004, 16)\n",
        "tds_nacl = 0.005 + 0.188 * (d_nacl / 0.225) + np.random.normal(0, 0.002, 16)\n",
        "turb_nacl = 0.0015 + 0.0022 * (d_nacl / 0.225) + np.abs(np.random.normal(0, 0.0002, 16))\n",
        "\n",
        "d_h2o2 = doses[54:68]\n",
        "pH_h2o2 = 2.27 + 0.62 * (d_h2o2 / 26.0) + np.random.normal(0, 0.005, 14)\n",
        "tds_h2o2 = 0.010 + 0.075 * (d_h2o2 / 26.0) + np.random.normal(0, 0.0015, 14)\n",
        "turb_h2o2 = 0.0020 + 0.0025 * (d_h2o2 / 26.0) + np.abs(np.random.normal(0, 0.0002, 14))\n",
        "\n",
        "d_mg = doses[68:79]\n",
        "pH_mg = 2.225 + 0.145 * (d_mg / 0.10) + np.random.normal(0, 0.003, 11)\n",
        "tds_mg = 0.013 + 0.028 * (d_mg / 0.10) + np.random.normal(0, 0.001, 11)\n",
        "turb_mg = 0.0028 - 0.0006 * (d_mg / 0.10) + np.abs(np.random.normal(0, 0.0001, 11))\n",
        "\n",
        "df_train = pd.DataFrame({\n",
        "    'Chemical': chems,\n",
        "    'Dose': doses,\n",
        "    'pH': np.concatenate([pH_nahco3, pH_caco3, pH_nacl, pH_h2o2, pH_mg]),\n",
        "    'TDS': np.concatenate([tds_nahco3, tds_caco3, tds_nacl, tds_h2o2, tds_mg]),\n",
        "    'Turbidity': np.concatenate([turb_nahco3, turb_caco3, turb_nacl, turb_h2o2, turb_mg])\n",
        "})\n",
        "\n",
        "df_train['log_turbidity'] = np.log(1.0 + df_train['Turbidity'])\n",
        "df_train['ratio_pH_TDS']  = df_train['pH'] / df_train['TDS']\n",
        "features = ['pH', 'TDS', 'Turbidity', 'log_turbidity', 'ratio_pH_TDS']\n",
        "classes_5 = sorted(df_train['Chemical'].unique())\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(df_train[features].values)\n",
        "y_train_cls = df_train['Chemical'].values\n",
        "\n",
        "clf_single = SVC(kernel='rbf', C=15.0, probability=True, random_state=42)\n",
        "clf_single.fit(X_train_scaled, y_train_cls)\n",
        "print(f'SUCCESS! Trained baseline Single-Label SVM on {len(df_train)} samples across 5 chemical classes.')\n",
        "print(f'Baseline Training Accuracy: {accuracy_score(y_train_cls, clf_single.predict(X_train_scaled))*100:.2f}%')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 2 (Part 1): Test Single-Label SVM on 10 Binary Chemical Mixtures\n",
        "**Action:** Click the **Play button (\u25b6)** below. This tests our baseline single-label model on 10 multi-contaminant mixtures, including the exact empirical mixtures from Musunooru Table 7-5!"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "mix_data = [\n",
        "    {'Mixture_ID': 'M1 (Thesis Table 7-5)', 'Components': 'Mg (0.021g) + NaCl (0.065g)', 'True_Classes': ['Magnesium', 'Sodium Chloride'], 'pH': 2.797, 'TDS': 0.029, 'Turbidity': 0.001, 'Doses': [0.0, 0.0, 0.065, 0.0, 0.021]},\n",
        "    {'Mixture_ID': 'M2 (Thesis Table 7-5)', 'Components': 'H2O2 (26mL) + CaCO3 (0.21g)', 'True_Classes': ['Calcium Carbonate', 'Hydrogen Peroxide'], 'pH': 2.106, 'TDS': 0.057, 'Turbidity': 0.003, 'Doses': [0.0, 0.21, 0.0, 26.0, 0.0]},\n",
        "    {'Mixture_ID': 'M3 (Ionic Dominance)', 'Components': 'NaCl (0.18g) + Mg (0.02g)', 'True_Classes': ['Magnesium', 'Sodium Chloride'], 'pH': 2.38, 'TDS': 0.165, 'Turbidity': 0.0025, 'Doses': [0.0, 0.0, 0.18, 0.0, 0.02]},\n",
        "    {'Mixture_ID': 'M4 (Buffer + Salt)', 'Components': 'NaHCO3 (0.35g) + NaCl (0.08g)', 'True_Classes': ['Sodium Bicarbonate', 'Sodium Chloride'], 'pH': 2.62, 'TDS': 0.210, 'Turbidity': 0.028, 'Doses': [0.35, 0.0, 0.08, 0.0, 0.0]},\n",
        "    {'Mixture_ID': 'M5 (Particulate + Salt)', 'Components': 'CaCO3 (0.30g) + NaCl (0.10g)', 'True_Classes': ['Calcium Carbonate', 'Sodium Chloride'], 'pH': 2.25, 'TDS': 0.115, 'Turbidity': 1.450, 'Doses': [0.0, 0.30, 0.10, 0.0, 0.0]},\n",
        "    {'Mixture_ID': 'M6 (Oxidizer + Buffer)', 'Components': 'H2O2 (18mL) + NaHCO3 (0.25g)', 'True_Classes': ['Hydrogen Peroxide', 'Sodium Bicarbonate'], 'pH': 2.75, 'TDS': 0.160, 'Turbidity': 0.020, 'Doses': [0.25, 0.0, 0.0, 18.0, 0.0]},\n",
        "    {'Mixture_ID': 'M7 (Particulate + Metal)', 'Components': 'CaCO3 (0.25g) + Mg (0.04g)', 'True_Classes': ['Calcium Carbonate', 'Magnesium'], 'pH': 2.30, 'TDS': 0.048, 'Turbidity': 1.150, 'Doses': [0.0, 0.25, 0.0, 0.0, 0.04]},\n",
        "    {'Mixture_ID': 'M8 (Low Salt + Low H2O2)', 'Components': 'NaCl (0.04g) + H2O2 (6mL)', 'True_Classes': ['Hydrogen Peroxide', 'Sodium Chloride'], 'pH': 2.45, 'TDS': 0.060, 'Turbidity': 0.0022, 'Doses': [0.0, 0.0, 0.04, 6.0, 0.0]},\n",
        "    {'Mixture_ID': 'M9 (Double Buffer)', 'Components': 'NaHCO3 (0.40g) + CaCO3 (0.15g)', 'True_Classes': ['Calcium Carbonate', 'Sodium Bicarbonate'], 'pH': 2.58, 'TDS': 0.190, 'Turbidity': 0.650, 'Doses': [0.40, 0.15, 0.0, 0.0, 0.0]},\n",
        "    {'Mixture_ID': 'M10 (Buffer + Metal)', 'Components': 'NaHCO3 (0.20g) + Mg (0.06g)', 'True_Classes': ['Magnesium', 'Sodium Bicarbonate'], 'pH': 2.52, 'TDS': 0.110, 'Turbidity': 0.015, 'Doses': [0.20, 0.0, 0.0, 0.0, 0.06]}\n",
        "]\n",
        "\n",
        "df_mix = pd.DataFrame(mix_data)\n",
        "df_mix['log_turbidity'] = np.log(1.0 + df_mix['Turbidity'])\n",
        "df_mix['ratio_pH_TDS']  = df_mix['pH'] / df_mix['TDS']\n",
        "\n",
        "X_mix_scaled = scaler.transform(df_mix[features].values)\n",
        "preds_single = clf_single.predict(X_mix_scaled)\n",
        "probs_single = np.max(clf_single.predict_proba(X_mix_scaled), axis=1)\n",
        "\n",
        "part1_results = []\n",
        "for i, row in df_mix.iterrows():\n",
        "    pred = preds_single[i]\n",
        "    status = 'Masked (Identified 1 of 2)' if pred in row['True_Classes'] else 'CONFUSED (Wrong 3rd Class)'\n",
        "    part1_results.append({\n",
        "        'Mixture ID': row['Mixture_ID'],\n",
        "        'Actual Contaminants Present': row['Components'],\n",
        "        'Single-Label Prediction': pred,\n",
        "        'Model Confidence': f'{probs_single[i]*100:.1f}%',\n",
        "        'Failure Mode': status\n",
        "    })\n",
        "\n",
        "print('=== PART 1: SINGLE-LABEL SVM PREDICTIONS ON MIXTURES ===')\n",
        "print(pd.DataFrame(part1_results).to_string(index=False))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 3 (Part 2): Multi-Label Classification via Binary Relevance\n",
        "**Action:** Click the **Play button (\u25b6)** below. This trains 5 independent One-vs-Rest binary classifiers (one per chemical) to see if the system can simultaneously flag both co-occurring contaminants."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Convert training labels into a 5-column binary indicator matrix (One-Hot)\n",
        "Y_train_binary = pd.get_dummies(df_train['Chemical'])[classes_5].values\n",
        "\n",
        "# Build ground-truth binary matrix for the 10 test mixtures\n",
        "Y_mix_true = np.zeros((len(df_mix), 5))\n",
        "for idx, row in df_mix.iterrows():\n",
        "    for c in row['True_Classes']:\n",
        "        Y_mix_true[idx, classes_5.index(c)] = 1.0\n",
        "\n",
        "# Train 5 independent binary SVM classifiers\n",
        "ovr_classifier = OneVsRestClassifier(SVC(kernel='rbf', C=15.0, probability=True, random_state=42))\n",
        "ovr_classifier.fit(X_train_scaled, Y_train_binary)\n",
        "\n",
        "# Predict probabilities and evaluate binary flags\n",
        "Y_mix_prob = ovr_classifier.predict_proba(X_mix_scaled)\n",
        "Y_mix_pred = (Y_mix_prob >= 0.30).astype(int)\n",
        "\n",
        "part2_results = []\n",
        "for i, row in df_mix.iterrows():\n",
        "    detected = [classes_5[j] for j in range(5) if Y_mix_pred[i, j] == 1]\n",
        "    match = set(detected) == set(row['True_Classes'])\n",
        "    part2_results.append({\n",
        "        'Mixture ID': row['Mixture_ID'],\n",
        "        'Actual Contaminants': row['Components'],\n",
        "        'Binary Relevance Flags': ', '.join(detected) if detected else 'None Detected',\n",
        "        'Both Contaminants Found?': 'YES' if match else ('PARTIAL' if len(set(detected).intersection(row['True_Classes']))>0 else 'NO')\n",
        "    })\n",
        "\n",
        "print('=== PART 2: BINARY RELEVANCE MULTI-LABEL DETECTION ===')\n",
        "print(pd.DataFrame(part2_results).to_string(index=False))\n",
        "print(f'\\nOverall Multi-Label Hamming Loss: {hamming_loss(Y_mix_true, Y_mix_pred):.4f}')\n",
        "print(f'Subset Accuracy (Exact Match for both): {accuracy_score(Y_mix_true, Y_mix_pred)*100:.1f}%')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "--- \n",
        "## STEP 4 (Part 3): Multi-Output Concentration Regression & Underdetermined Systems\n",
        "**Action:** Click the **Play button (\u25b6)** below. This trains a Multi-Output Random Forest Regressor to simultaneously predict the 5-element concentration vector $[C_{NaHCO3}, C_{CaCO3}, C_{NaCl}, C_{H2O2}, C_{Mg}]$. Look at why $R^2$ collapses!"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Construct true 5-channel dose vectors for training\n",
        "Y_train_doses = np.zeros((len(df_train), 5))\n",
        "for idx, row in df_train.iterrows():\n",
        "    Y_train_doses[idx, classes_5.index(row['Chemical'])] = row['Dose']\n",
        "\n",
        "rf_multi = RandomForestRegressor(n_estimators=100, random_state=42)\n",
        "rf_multi.fit(X_train_scaled, Y_train_doses)\n",
        "\n",
        "# Predict on binary mixtures\n",
        "pred_doses_mix = rf_multi.predict(X_mix_scaled)\n",
        "true_doses_mix = np.array([r['Doses'] for r in mix_data])\n",
        "\n",
        "part3_results = []\n",
        "for j, c in enumerate(classes_5):\n",
        "    r2 = r2_score(true_doses_mix[:, j], pred_doses_mix[:, j])\n",
        "    rmse = np.sqrt(mean_squared_error(true_doses_mix[:, j], pred_doses_mix[:, j]))\n",
        "    part3_results.append({\n",
        "        'Chemical Channel': c,\n",
        "        'Primary Sensor Axis': 'Turbidity' if 'Calcium' in c else ('pH' if 'Peroxide' in c or 'Bicarbonate' in c else 'TDS'),\n",
        "        'Regression R2': round(r2, 4),\n",
        "        'RMSE': round(rmse, 4),\n",
        "        'Degree of Masking': 'Severe' if r2 < 0 else 'Moderate'\n",
        "    })\n",
        "\n",
        "print('=== PART 3: MULTI-OUTPUT CONCENTRATION REGRESSION ===')\n",
        "print(pd.DataFrame(part3_results).to_string(index=False))"
      ]
