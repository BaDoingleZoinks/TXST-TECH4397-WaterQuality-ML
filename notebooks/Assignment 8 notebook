        "--- \n",
        "## STEP 5 (Part 4): The Chemical Masking Interaction Surface Plot\n",
        "**Action:** Click the **Play button (\u25b6)** below to generate the **Required Interaction Plot**. This illustrates Kohlrausch's Law of Independent Migration: how a dominant ionic salt completely masks a trace contaminant!"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "nacl_sweep = np.linspace(0.0, 0.25, 30)  # NaCl dose (g)\n",
        "mg_sweep   = np.linspace(0.0, 0.10, 30)  # Mg dose (g)\n",
        "NACL_GRID, MG_GRID = np.meshgrid(nacl_sweep, mg_sweep)\n",
        "\n",
        "# TDS response based on molar conductivities (Kohlrausch's Law)\n",
        "# NaCl yields 0.188 V per 0.225g; Mg yields 0.028 V per 0.10g\n",
        "TDS_COMBINED = 0.005 + (0.188 / 0.225) * NACL_GRID + (0.028 / 0.10) * MG_GRID\n",
        "\n",
        "fig = plt.figure(figsize=(10, 6), dpi=120)\n",
        "ax = fig.add_subplot(111, projection='3d')\n",
        "surf = ax.plot_surface(NACL_GRID, MG_GRID, TDS_COMBINED, cmap='viridis', edgecolor='none', alpha=0.85)\n",
        "\n",
        "ax.set_title('Chemical Masking Surface: Kohlrausch Ion Conductivity Law', fontsize=13, fontweight='bold', pad=15)\n",
        "ax.set_xlabel('Sodium Chloride Dose (g)', fontsize=10, labelpad=10)\n",
        "ax.set_ylabel('Magnesium Dose (g)', fontsize=10, labelpad=10)\n",
        "ax.set_zlabel('Sensor TDS Reading (V)', fontsize=10, labelpad=10)\n",
        "fig.colorbar(surf, shrink=0.5, aspect=10, label='Conductivity Voltage (V)')\n",
        "ax.view_init(elev=25, azim=135)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
